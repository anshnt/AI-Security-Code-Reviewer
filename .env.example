# ---------------------------------------------------------------------------
# GitHub access
# ---------------------------------------------------------------------------

# Token used to read diffs, post comments and set commit statuses.
# Classic token: `repo` scope. Fine-grained token: read on Contents and Pull
# requests, write on Pull requests and Commit statuses.
GITHUB_TOKEN=

# Shared secret configured on the repository webhook. Payloads are authenticated
# against this before they are parsed; without it the endpoint would accept
# forged events, so the process refuses to start unless it is set.
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Override for GitHub Enterprise Server.
# GITHUB_API_URL=https://github.example.com/api/v3

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3000

# Externally reachable base URL. Used to link pull-request comments to the
# dashboard, so leave it unset for local development rather than guessing.
# PUBLIC_URL=https://review.example.com

# Set to true to run the dashboard without a webhook secret. Only sensible when
# the /webhook route is unreachable.
# ALLOW_INSECURE_WEBHOOK=false

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite file. The directory is created if it does not exist.
DATABASE_PATH=data/reviews.sqlite

# ---------------------------------------------------------------------------
# Review behaviour
# ---------------------------------------------------------------------------

# Findings below this severity are never reported.
# critical | high | medium | low | info
MIN_SEVERITY=low

# Severity at or above which the commit status is reported as failing, so it can
# gate a merge through branch protection. Use `never` for an advisory-only
# reviewer that comments but never blocks.
FAIL_ON_SEVERITY=high

# Comma-separated rule IDs or category names to skip entirely, e.g.
# DISABLED_RULES=dangerous-api/insecure-temp-file,dependencies
DISABLED_RULES=

# Scan paths that look like tests and fixtures. Off by default: test files
# legitimately contain fake credentials and deliberately unsafe examples.
INCLUDE_TESTS=false

# Per-file cap, so one bad file cannot flood a review.
MAX_FINDINGS_PER_FILE=25

# Cap on findings rendered individually in the comment; the rest are summarised.
MAX_FINDINGS_PER_COMMENT=40

# Skip files larger than this (bytes). Large files are usually generated.
MAX_FILE_BYTES=400000

# Pull requests touching more than this many files are skipped rather than
# reviewed badly. The commit status still passes, with an explanation.
MAX_FILES_PER_PR=300

# Post findings as inline comments on the changed lines, in addition to the
# summary. Every finding is always in the summary, so turning this off loses
# convenience rather than information.
INLINE_COMMENTS=true

# Cap on inline comments per review. Fifteen is a review; sixty is a denial of
# service against the author's attention.
MAX_INLINE_COMMENTS=15

# Only findings at or above this severity are posted inline.
INLINE_MIN_SEVERITY=medium

# ---------------------------------------------------------------------------
# Model-assisted triage (optional)
# ---------------------------------------------------------------------------
# A second pass over the deterministic findings: it reads the surrounding code
# and decides whether each finding is real *there*, rewrites the explanation in
# terms of the actual code, and proposes a specific fix.
#
# This sends bounded, credential-scrubbed source excerpts to a third-party API.
# Read the README section before enabling it, and decide deliberately.
#
# Triage is off unless BOTH of these are set.

# Credential for the model API.
# ANTHROPIC_API_KEY=

# Model identifier, or `auto` to use the newest model the credential can see.
# Pin an explicit identifier for a reproducible pipeline; `auto` is for "give me
# the best available and do not make me maintain a version string".
# AI_MODEL=auto

# Explicitly disable even when a key and model are present.
# AI_TRIAGE=false

# Only findings at or above this severity are sent, which is the main cost dial.
# AI_MIN_SEVERITY=medium

# Hard cap per review. One pathological pull request cannot run up a bill.
# AI_MAX_FINDINGS=25

# Lines of context sent on each side of a finding, and the per-file ceiling.
# More context means better judgement and more exposure; these are the knobs.
# AI_CONTEXT_LINES=25
# AI_MAX_LINES_PER_FILE=220

# Reasoning effort: low | medium | high | xhigh | max
# AI_EFFORT=high

# AI_MAX_TOKENS=8000
# AI_TIMEOUT_MS=120000
# AI_MAX_RETRIES=2

# Drop refuted findings from the review entirely instead of moving them into a
# labelled section. Off by default: a wrong refutation would silently hide a
# real vulnerability, so a human should see them until you trust the pass.
# AI_DROP_REFUTED=false

# Override the API base URL, for a gateway or proxy.
# AI_BASE_URL=
