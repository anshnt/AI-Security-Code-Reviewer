{
  "name": "ai-security-code-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Automated security review agent for GitHub pull requests, with a vulnerability trend dashboard.",
  "author": "ansh",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed-demo.ts --database data/demo.sqlite",
    "diagrams": "tsx scripts/build-diagrams.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@octokit/rest": "^21.1.1",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "bin": {
    "security-review": "dist/cli/index.js"
  }
}
